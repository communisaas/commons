{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    /* `lib/districtHash.ts` reads `process.env` at call time (empty at module
     * scope on Workers). Node types were previously pulled in transitively by a
     * test that is now excluded. */
    "types": ["node"]
  },
  "include": ["./**/*"],
  /* `credential-receipt-terminal-state.convex.test.ts` imports a SvelteKit route
   * to prove an end-to-end boundary. Resolving `$lib` and a route's generated
   * `./$types` here would drag SvelteKit-only virtual modules ($env/dynamic/*)
   * into this project, which cannot resolve outside a Vite build. It is a test,
   * not a deployed function; vitest typechecks and runs it. */
  "exclude": ["./_generated", "./credential-receipt-terminal-state.convex.test.ts"]
}
